# Neon PostgreSQL connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
# Use the deployed HTTPS URL in production, without a trailing slash.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Flutterwave
# Use FLWSECK_TEST-... for sandbox and FLWSECK_LIVE-... only in production.
FLW_SECRET_KEY="FLWSECK_TEST-replace-me"
# Set this to the same secret hash configured in Flutterwave's webhook settings.
FLW_WEBHOOK_SECRET_HASH="replace-with-your-webhook-secret-hash"
